#!/bin/sh

echo "Запуск проверок перед пушем"

# Останавливаем пуш при первой же ошибке
set -e

# Проверяем типы и гоняем тесты для измененных пакетов И тех, кто от них зависит
pnpm run typecheck --filter="...[origin/master]"
pnpm run test --filter="...[origin/master]"

echo "✅ Проверки пройдены, код отправляется! ✅"
